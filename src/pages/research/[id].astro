---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { profile } from '../../data/site';

export async function getStaticPaths() {
  const research = await getCollection('research');

  return research.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
const mediaHref = (path: string) => path.startsWith('http') ? path : withBase(path);
const ImageWrapper = entry.data.imageLink ? 'a' : 'div';
const DetailImageWrapper = entry.data.detailImageLink ? 'a' : 'div';
---

<SiteLayout
  title={entry.data.shortTitle}
  description={entry.data.summary}
  active="research"
  image={entry.data.image}
>
  <article class="detail-page shell">
    <a class="back-link" href={withBase('research/')}><span aria-hidden="true">←</span> All research</a>

    <header class="detail-header">
      <div class="work-meta">
        <span>{entry.data.year}</span>
        <span>{entry.data.venue}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="detail-summary">{entry.data.summary}</p>
      <p class="detail-authors">
        {entry.data.authors.map((author, index) => (
          <>
            {index > 0 && ', '}
            {author === profile.name ? <strong>{author}</strong> : author}
          </>
        ))}
      </p>
      {entry.data.award && <p class="award detail-award">{entry.data.award}</p>}
      <div class="link-row detail-actions">
        {entry.data.projectPage && (
          <a href={withBase(entry.data.projectPage)}>
            Project Page<span aria-hidden="true">↗</span>
          </a>
        )}
        {entry.data.links.map((link) => (
          <a href={link.url.startsWith('http') ? link.url : withBase(link.url)} target="_blank" rel="noreferrer">
            {link.label}<span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </header>

    <figure class="detail-media">
      <ImageWrapper
        href={entry.data.imageLink ? mediaHref(entry.data.imageLink) : undefined}
        target={entry.data.imageLink ? '_blank' : undefined}
        rel={entry.data.imageLink ? 'noreferrer' : undefined}
      >
        <img
          class:list={{ mediaContain: entry.data.imageFit === 'contain' }}
          src={withBase(entry.data.image)}
          alt={entry.data.imageAlt}
          width="1280"
          height="800"
        />
      </ImageWrapper>
      {entry.data.imageCaption && <figcaption>{entry.data.imageCaption}</figcaption>}
    </figure>

    <div class="prose">
      <Content />
    </div>

    {entry.data.architecture.length > 0 && (
      <section class="research-architecture" aria-labelledby="architecture-heading">
        <h2 id="architecture-heading" class="media-heading">Network architecture</h2>
        <div class="architecture-grid">
          {entry.data.architecture.map((diagram) => (
            <figure>
              <a href={withBase(diagram.image)} target="_blank" rel="noreferrer" aria-label={`Open ${diagram.title} at full size`}>
                <img src={withBase(diagram.image)} alt={diagram.alt} width={diagram.width} height={diagram.height} loading="lazy" />
              </a>
              <figcaption>{diagram.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {
      entry.data.detailImage && (
        <figure class="detail-figure">
          {entry.data.detailImageHeading && <h2 class="media-heading">{entry.data.detailImageHeading}</h2>}
          <DetailImageWrapper
            href={entry.data.detailImageLink ? mediaHref(entry.data.detailImageLink) : undefined}
            target={entry.data.detailImageLink ? '_blank' : undefined}
            rel={entry.data.detailImageLink ? 'noreferrer' : undefined}
          >
            <img
              src={withBase(entry.data.detailImage)}
              alt={entry.data.detailImageAlt ?? ''}
              width={entry.data.detailImageWidth}
              height={entry.data.detailImageHeight}
              loading="lazy"
            />
          </DetailImageWrapper>
          {entry.data.detailImageCaption && (
            <figcaption>{entry.data.detailImageCaption}</figcaption>
          )}
        </figure>
      )
    }

    {entry.data.gallery.length > 0 && (
      <section class="research-gallery" aria-label={entry.data.galleryHeading ?? 'Research photos'}>
        {entry.data.galleryHeading && <h2 class="media-heading">{entry.data.galleryHeading}</h2>}
        <div class="gallery-grid">
          {entry.data.gallery.map((photo) => (
            <figure>
              <a href={withBase(photo.image)} target="_blank" rel="noreferrer">
                <img src={withBase(photo.image)} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" />
              </a>
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>
</SiteLayout>

<style>
  .detail-media a,
  .detail-figure a,
  .research-architecture a,
  .research-gallery a { display: block; }
  .detail-media figcaption { padding: 14px 18px; background: white; }
  .detail-media figcaption,
  .research-architecture figcaption,
  .research-gallery figcaption { color: var(--muted); font-size: 13px; line-height: 1.55; }
  .media-heading { margin: 0 0 20px; font-size: 20px; line-height: 1.4; }
  .research-architecture,
  .research-gallery { margin-top: clamp(42px, 7vw, 72px); }
  .architecture-grid,
  .gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .architecture-grid { align-items: start; }
  .architecture-grid figure,
  .gallery-grid figure { margin: 0; }
  .architecture-grid img,
  .gallery-grid img { width: 100%; height: auto; border-radius: 3px; }
  .architecture-grid figcaption,
  .gallery-grid figcaption { margin-top: 12px; }
  @media (max-width: 640px) {
    .architecture-grid,
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>
