---
import SiteLayout from '../../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path}`;
const performances = [
  {
    id: 'fantaisie_impromptu',
    title: 'Fantaisie Impromptu',
  },
  {
    id: 'phantom_of_the_opera',
    title: 'The Phantom of the Opera',
  },
];
---

<SiteLayout
  title="Some Favorite Pieces"
  description="Piano performances by Boyang Chen, featuring Chopin and The Phantom of the Opera."
  image="media/piano/fantaisie_impromptu.jpg"
  showBrand={false}
>
  <div class="shell piano-page">
    <header class="piano-header">
      <a class="home-link" href={withBase('')}>Home</a>
      <h1>Some Favorite Pieces</h1>
    </header>

    <div class="performances">
      {performances.map((piece) => (
        <section class="performance" aria-labelledby={`${piece.id}_title`}>
          <h2 id={`${piece.id}_title`}>{piece.title}</h2>
          <video
            controls
            playsinline
            preload="none"
            poster={withBase(`media/piano/${piece.id}.jpg`)}
            width="1280"
            height="720"
            aria-label={`${piece.title}, performed by Boyang Chen, with a following score`}
          >
            <source src={withBase(`media/piano/${piece.id}.mp4${piece.id === 'fantaisie_impromptu' ? '?v=2' : ''}`)} type="video/mp4" />
            <p>Your browser cannot play this video. <a href={withBase(`media/piano/${piece.id}.mp4${piece.id === 'fantaisie_impromptu' ? '?v=2' : ''}`)}>Open the performance</a>.</p>
          </video>
        </section>
      ))}
    </div>
  </div>
</SiteLayout>

<script>
  const players = document.querySelectorAll<HTMLVideoElement>('.performance video');
  players.forEach((player) => {
    player.addEventListener('play', () => {
      players.forEach((other) => {
        if (other !== player) other.pause();
      });
    });
  });
</script>

<style>
  .piano-page { padding-block: clamp(36px, 6vw, 68px) clamp(60px, 8vw, 100px); }
  .piano-header { margin-bottom: clamp(40px, 6vw, 64px); }
  .home-link { display: inline-block; margin-bottom: 36px; color: var(--muted); font-size: 14px; }
  .piano-header h1 { margin-bottom: 0; font-size: clamp(32px, 5vw, 56px); letter-spacing: 0; line-height: 1.3; }
  .performances { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; row-gap: 20px; }
  .performance { display: grid; grid-template-rows: subgrid; grid-row: span 2; min-width: 0; }
  h2 { margin-bottom: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(25px, 3vw, 30px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.15; }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #111; border-radius: 3px; }
  @media (max-width: 600px) {
    .performances { grid-template-columns: 1fr; row-gap: 36px; }
    .performance { grid-template-rows: auto auto; grid-row: auto; gap: 20px; }
  }
</style>
