---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { humanPoweredAirplane } from '../../data/site';

const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
const media = (name: string) => withBase(`media/hpa/${name}`);
const historySource = 'https://engineering.uci.edu/documents/news-archive/2016/september/human-powered-airplane-team-learns-lessons-flight-test.php';
const teamSource = 'https://engineering.uci.edu/news/2023/august/revolutionary-plane-coming-soon.php';
const historicalPhotos = [
  {
    image: 'history_2014_team.webp',
    alt: 'The earlier UCI Human Powered Airplane team with Robert Liebeck beside a wing in 2014',
    caption: 'The earlier team with Robert Liebeck in 2014. Jacqueline is second from the left.',
    credit: 'Steve Zylius / UCI',
    source: teamSource,
    width: 600,
    height: 394,
  },
  {
    image: 'history_2016_team.webp',
    alt: 'The UCI team gathered in front of their aircraft at El Mirage in 2016',
    caption: 'The team at El Mirage in 2016.',
    credit: 'UCI Samueli School of Engineering',
    source: historySource,
    width: 450,
    height: 300,
  },
  {
    image: 'history_2016_night.webp',
    alt: 'Students assembling the original aircraft at night before its 2016 test',
    caption: 'Assembling the aircraft through the night before testing.',
    credit: 'UCI Samueli School of Engineering',
    source: historySource,
    width: 2000,
    height: 1335,
  },
  {
    image: 'history_2016_wing.webp',
    alt: 'Emiko Soroka standing under the long wing as the earlier team prepares for testing at sunrise',
    caption: 'Under the wing as the team prepared for testing at sunrise.',
    credit: 'UCI Samueli School of Engineering',
    source: historySource,
    width: 1800,
    height: 1201,
  },
];
---

<SiteLayout title={humanPoweredAirplane.title} description={humanPoweredAirplane.summary} image={humanPoweredAirplane.image}>
  <article class="detail-page shell hpa-project">
    <a class="back-link" href={withBase('#projects')}>All projects</a>

    <header class="detail-header">
      <div class="work-meta"><span>{humanPoweredAirplane.context}</span></div>
      <h1>Human Powered Airplane</h1>
      <p class="detail-summary">Restarting UCI's human powered airplane project with my advisor.</p>
    </header>

    <div class="overview">
      <div class="overview-copy">
        <p>
          My advisor, <strong>Jacqueline Huynh</strong> (formerly Jacqueline Thomas), restarted UCI's Human Powered
          Airplane project in 2011. The project had been inactive for years, and now
          I am restarting it with her.
        </p>
        <p>
          We have six other members on the team, seven including me. I am the team
          lead and am responsible for the overall aircraft design.
        </p>
        <a class="text-link" href="#earlier-team">The earlier UCI team</a>
      </div>
      <figure class="hpa-figure aircraft-overview">
        <a href={media('aircraft_overall.webp')} target="_blank" rel="noreferrer" aria-label="Open the full aircraft CAD view">
          <img src={media('aircraft_overall.webp')} alt="Overall CAD assembly of our current human powered airplane design, with a long wing, suspended frame, and tail" width="2000" height="1971" fetchpriority="high" />
        </a>
        <figcaption>Our current aircraft design.</figcaption>
      </figure>
    </div>

    <section class="hpa-section" aria-labelledby="team-heading">
      <div class="section-copy">
        <h2 id="team-heading">My role on the team</h2>
        <p>
          As team lead, I coordinate the project, assign tasks, integrate my teammates'
          CAD models, and handle fundraising. My design work covers the overall aircraft,
          aerodynamics, drivetrain, gearbox, and airframe structure.
        </p>
      </div>
      <figure class="hpa-figure team-photo">
        <img src={media('current_team.webp')} alt="Our current Human Powered Airplane team, with all seven members standing together" width="1822" height="964" loading="lazy" />
        <figcaption>Our current team.</figcaption>
      </figure>
    </section>

    <section class="hpa-section" aria-labelledby="aerodynamics-heading">
      <div class="section-copy">
        <h2 id="aerodynamics-heading">Choosing the aircraft parameters</h2>
        <p>
          The early design involved comparing different airfoils, wingspans, and wing
          areas. XFOIL provided the aerodynamic data, while XROTOR helped optimize the
          propeller and reduce its induced losses.
        </p>
        <p>
          I built an online database from these results to help narrow down the
          aircraft's main parameters. All the data are precomputed with XFOIL and
          XROTOR, so we can compare designs without running each calculation again.
        </p>
        <div class="link-row database-link">
          <a href="https://hpaxfoil.jerryc.link/Xfoil/" target="_blank" rel="noreferrer">Explore the aircraft design database</a>
        </div>
        <p>
          The database helped a lot with the early decisions. Based on these results,
          I chose a <strong>28 m wingspan</strong> and <strong>40 m² wing area</strong>.
          The chord and twist distributions were also optimized using the XFOIL data.
        </p>
      </div>
      <div class="calculation-grid">
      <figure class="hpa-figure">
        <a href={media('xfoil_airfoil.jpg')} target="_blank" rel="noreferrer" aria-label="Open the DAE31 airfoil calculation at full size">
          <img src={media('xfoil_airfoil.jpg')} alt="XFOIL pressure distribution and geometry for the DAE31 airfoil at a Reynolds number of 600000 and an angle of attack of 4 degrees" width="1657" height="1326" loading="lazy" />
        </a>
        <figcaption>A DAE31 airfoil calculation in XFOIL, showing the pressure distribution and aerodynamic coefficients.</figcaption>
      </figure>
      <figure class="hpa-figure">
        <a href={media('xfoil_terminal.jpg')} target="_blank" rel="noreferrer" aria-label="Open the XFOIL calculation terminal at full size">
          <img src={media('xfoil_terminal.jpg')} alt="XFOIL terminal showing the DAE31 calculation converging and saving a point to the polar data file" width="980" height="511" loading="lazy" />
        </a>
        <figcaption>The calculation converging and saving its results to a polar file for the database.</figcaption>
      </figure>
      </div>
    </section>

    <section class="hpa-section" aria-labelledby="mechanical-heading">
      <div class="section-copy">
        <h2 id="mechanical-heading">Drivetrain and gearbox</h2>
        <p>
          My work on the drivetrain includes the gearbox design, CAD models, and
          engineering drawings. Pedal power passes through a chain, two 1:1 bevel
          gearboxes, and a vertical shaft before reaching the propeller. Losses in
          the transmission and propeller determine how much power the pilot needs to supply.
        </p>
      </div>
      <figure class="hpa-figure analysis-figure" data-source-figure="1">
        <a href={media('drivetrain_layout.webp')} target="_blank" rel="noreferrer" aria-label="Open the drivetrain layout at full size">
          <img src={media('drivetrain_layout.webp')} alt="Drivetrain diagram tracing pedal power through the chain, lower gearbox, vertical shaft, upper gearbox, and propeller" width="2280" height="1824" loading="lazy" />
        </a>
        <figcaption>The drivetrain layout and the power path from the pedals to the propeller.</figcaption>
      </figure>
      <div class="drawing-grid">
        <figure class="hpa-figure">
          <a href={media('gearbox_section_aa.png')} target="_blank" rel="noreferrer" aria-label="Open the gearbox section drawing at full size">
            <img src={media('gearbox_section_aa.webp')} alt="Section drawing showing the gearbox shafts, bevel gears, and bearing arrangement" width="2340" height="1585" loading="lazy" />
          </a>
          <figcaption>Gearbox section and bearing arrangement.</figcaption>
        </figure>
        <figure class="hpa-figure">
          <a href={media('gearbox_exploded.png')} target="_blank" rel="noreferrer" aria-label="Open the exploded gearbox assembly at full size">
            <img src={media('gearbox_exploded.webp')} alt="Exploded gearbox assembly showing the housing, shafts, gears, bearings, and fastening components" width="2340" height="1410" loading="lazy" />
          </a>
          <figcaption>Exploded view of the gearbox assembly.</figcaption>
        </figure>
      </div>
      <div class="section-copy technical-note">
        <p>
          Under a 1000 N downward load at the tail tube connection, the ANSYS model
          of the 7075 T6 aluminum upper gearbox housing gave a peak unaveraged von
          Mises stress of 143.9 MPa and a maximum displacement of 0.299 mm. These
          results help check the housing's strength and stiffness.
        </p>
      </div>
      <figure class="hpa-figure stress-figure" data-source-figure="24">
        <a href={media('gearbox_stress.webp')} target="_blank" rel="noreferrer" aria-label="Open the gearbox housing stress analysis at full size">
          <img src={media('gearbox_stress.webp')} alt="ANSYS von Mises stress distribution in the upper gearbox housing under a 1000 N load, with a color scale from 0 to 143.9 MPa" width="2120" height="2170" loading="lazy" />
        </a>
        <figcaption>Upper gearbox housing stress under the 1000 N simulation load.</figcaption>
      </figure>
      <div class="photo-slots">
        <figure class="hpa-figure">
          <a href={media('gearbox_housing_photo.jpg')} target="_blank" rel="noreferrer" aria-label="Open the gearbox housing photo at full size">
            <img src={media('gearbox_housing_photo.jpg')} alt="Physical gearbox housing with a large circular bearing opening and open side walls" width="810" height="1440" loading="lazy" />
          </a>
          <figcaption>Gearbox housing.</figcaption>
        </figure>
        <figure class="hpa-figure">
          <a href={media('bearing_housing_photo.jpg')} target="_blank" rel="noreferrer" aria-label="Open the bearing housing photo at full size">
            <img src={media('bearing_housing_photo.jpg')} alt="Physical cylindrical bearing housing with a stepped bore and outer flange" width="810" height="1440" loading="lazy" />
          </a>
          <figcaption>Bearing housing.</figcaption>
        </figure>
      </div>
    </section>

    <section class="hpa-section" aria-labelledby="structure-heading">
      <div class="section-copy">
        <h2 id="structure-heading">Airframe structure</h2>
        <p>
          The frame carries the pilot, wing, and tail loads through its tubes, cables,
          and connections. Tube sizing balances weight with strength and stiffness,
          using bending, buckling, and deflection calculations to compare aluminum
          and carbon options.
        </p>
      </div>
      <figure class="hpa-figure" data-source-figure="8">
        <a href={media('frame_layout.webp')} target="_blank" rel="noreferrer" aria-label="Open the cabin frame layout at full size">
          <img src={media('frame_layout.webp')} alt="Side view of the cabin frame with labeled tubes, kingposts, cables, and connection nodes" width="2360" height="1330" loading="lazy" />
        </a>
        <figcaption>The cabin frame layout used in the structural calculations. The diagram is not to scale.</figcaption>
      </figure>
      <div class="section-copy technical-note">
        <p>
          The full CAD assembly combines the team's models in one aircraft. This lets
          us check how the wing, frame, propeller, and drivetrain fit together as the
          individual parts develop.
        </p>
      </div>
      <figure class="hpa-figure">
        <a href={media('aircraft_detail.webp')} target="_blank" rel="noreferrer" aria-label="Open the aircraft structure and drivetrain CAD detail">
          <img src={media('aircraft_detail.webp')} alt="Detailed CAD view of the wing ribs and spars above the suspended frame, propeller, and pedal drivetrain" width="2400" height="1337" loading="lazy" />
        </a>
        <figcaption>The wing structure, frame, and drivetrain in our current CAD assembly.</figcaption>
      </figure>
    </section>

    <section class="hpa-section history-section" id="earlier-team" aria-labelledby="history-heading">
      <div class="section-copy">
        <p class="eyebrow">Project history</p>
        <h2 id="history-heading">The earlier UCI team</h2>
        <p>
          These are photos from the earlier UCI team. In 2016, they tested an electric,
          remotely controlled version of the aircraft at El Mirage. This is the
          project my advisor worked on before we restarted it together.
        </p>
      </div>
      <div class="history-grid">
        {historicalPhotos.map((photo) => (
          <figure class="hpa-figure">
            <a href={media(photo.image)} target="_blank" rel="noreferrer" aria-label={`Open ${photo.caption}`}>
              <img src={media(photo.image)} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" />
            </a>
            <figcaption>
              {photo.caption}
              <span class="photo-credit"><a href={photo.source} target="_blank" rel="noreferrer">{photo.credit}</a></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  </article>
</SiteLayout>

<style>
  .back-link { margin-bottom: 38px; font-size: 14px; }
  .work-meta, .eyebrow { font-size: 14px; }
  .detail-header { max-width: none; }
  .detail-header h1 { font-size: clamp(42px, 6.1vw, 66px); }
  .detail-summary { margin-bottom: 0; }
  .overview { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(28px, 5vw, 58px); margin-top: 28px; }
  .overview-copy p, .section-copy p { color: var(--muted); }
  .overview-copy strong { color: var(--ink); }
  .overview-copy .text-link { display: inline-block; margin-top: 4px; }
  .hpa-figure { min-width: 0; margin: 26px 0 0; }
  .hpa-figure > a { display: block; }
  .hpa-figure img { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 3px; background: white; }
  .hpa-figure figcaption { margin-top: 10px; color: var(--muted); font-size: 14px; line-height: 1.55; }
  .aircraft-overview { margin: 0; }
  .aircraft-overview img { border-color: transparent; }
  .aircraft-overview figcaption { text-align: center; }
  .hpa-section { margin-top: clamp(48px, 7vw, 76px); }
  .section-copy { max-width: 740px; }
  .section-copy h2 { margin-bottom: 18px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(28px, 3.8vw, 36px); font-weight: 500; line-height: 1.2; letter-spacing: -0.025em; }
  .section-copy p:last-child { margin-bottom: 0; }
  .team-photo { max-width: 900px; }
  .analysis-figure { max-width: 840px; }
  .stress-figure { max-width: 640px; }
  .technical-note { margin-top: 32px; }
  .database-link { margin: 22px 0; }
  .database-link a { font-size: 16px; }
  .photo-slots img { aspect-ratio: 3 / 4; object-fit: cover; }
  .drawing-grid, .history-grid, .photo-slots, .calculation-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px; margin-top: 28px; }
  .drawing-grid .hpa-figure, .history-grid .hpa-figure, .photo-slots .hpa-figure, .calculation-grid .hpa-figure { margin: 0; }
  .calculation-grid img { aspect-ratio: 5 / 4; object-fit: contain; background: #090909; }
  .drawing-grid img { height: 350px; object-fit: contain; padding: 12px; }
  .history-section { border-top: 1px solid var(--line); padding-top: clamp(40px, 6vw, 60px); }
  .history-grid img { aspect-ratio: 3 / 2; object-fit: cover; }
  .photo-credit { display: block; margin-top: 6px; font-size: 13px; }
  .photo-credit a { color: var(--accent); }
  @media (max-width: 720px) {
    .overview { grid-template-columns: 1fr; gap: 22px; margin-top: 28px; }
    .aircraft-overview { width: min(100%, 460px); margin-inline: auto; }
    .drawing-grid, .history-grid, .photo-slots, .calculation-grid { grid-template-columns: 1fr; gap: 28px; }
    .calculation-grid img { aspect-ratio: auto; }
    .drawing-grid img { height: auto; max-height: 600px; padding: 10px; }
    .history-grid { max-width: 560px; }
  }
</style>
